# REELFORGE configuration (copy to .env; .env is git-ignored). No secrets required.

# Paths
REELFORGE_DB=data/database/reelforge.sqlite
REELFORGE_OUTPUT=output
REELFORGE_VIDEO_ENGINE=video-engine
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Rendering
RENDER_PROFILE=standard            # draft | standard | cinematic
RENDER_LOCAL_CONCURRENCY=2
RENDER_MIN_FREE_RAM_MB=2500        # scheduler refuses to start Chrome below this

# Voice (text-to-speech). VOICE_PROVIDER wins over the storyboard's voice.provider;
# `--provider` on the synthesize command wins over both. Flip this line to switch.
VOICE_PROVIDER=sarvam              # sarvam | kokoro | piper
# Sarvam AI Bulbul (https://dashboard.sarvam.ai). The key lives only in .env.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3             # bulbul:v3 | bulbul:v4-flash (v2 is deprecated by Sarvam)
SARVAM_SPEAKER=shubh               # v3 ids: shubh, rahul, kabir, aditya, rohan, amit, dev, ... (tested 2026-11-10: shubh fastest, kabir deepest)
SARVAM_LANGUAGE=en-IN              # en-IN | hi-IN | ... (code-mixed Hinglish text works)
# Kokoro (local, free): the voice comes from the storyboard (am_fenrir).
TTS_DEVICE=auto                    # auto | cpu | cuda

# Ada cluster offload (optional). Uses the ssh host alias from ~/.ssh/config.
ADA_ENABLED=true
ADA_SSH_HOST=ada
ADA_PARTITION=plafnet2
ADA_ACCOUNT=plafnet2
ADA_EXCLUDE_NODES=gnode118
ADA_WORKDIR=/scratch/nishanth.r/reelforge
ADA_GPUS=1
ADA_CPUS=8
ADA_MEM=32G

# Research
RESEARCH_USER_AGENT=REELFORGE-research/0.1 (local, non-commercial research bot)
RESEARCH_MAX_ITEMS_PER_SOURCE=40

# Instagram publishing (official Graph API). Create in the Meta developer portal.
# Leave empty to keep publishing manual. Never commit .env.
IG_ACCESS_TOKEN=
IG_USER_ID=
# facebook = graph.facebook.com (Unified login and Facebook login tokens); instagram = graph.instagram.com (Instagram-login-only tokens)
IG_API_HOST=facebook
# Public hosting for the MP4 Instagram fetches. Default: raw.githubusercontent.com on the
# orphan `media` branch of MEDIA_GITHUB_REPO. Override with any public https base URL.
MEDIA_GITHUB_REPO=Nishanth-nishu/insta-bot
MEDIA_BRANCH=media
PUBLIC_MEDIA_BASE_URL=

# YouTube publishing (official Data API v3, free). Setup steps are at the top of
# services/publishing/youtube.py. Leave empty to keep publishing manual. Never commit .env.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Written by: python -m services.publishing.youtube --auth
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_MAX_UPLOADS_PER_DAY=6       # API quota allows about six uploads a day

# Story writer: any OpenAI-compatible chat server running on this machine
# (Ollama, llama.cpp server, LM Studio). Nothing leaves the laptop.
STORY_LLM_URL=http://localhost:11434/v1
STORY_LLM_MODEL=qwen2.5:7b-instruct
STORY_GUEST_VOICE=am_puck          # Kokoro voice for the second character in dialogue scenes
